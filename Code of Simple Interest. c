// Code Fir Simple Interest

#include<stdio.h>
int main()
{
	int P,R,T,SI;
     
     printf("Enter P=");
     scanf("%d",&P);
     
     printf("Enter R=");
     scanf("%d",&R);
     
     printf("Enter T=");
     scanf("%d",&T);
     
      SI=(P*R*T)/100 ;
       
       printf("%d",SI);
       
      return 0;
}